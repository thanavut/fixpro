rules_version = '2';

// ============================================================
// FixPro — กฎความปลอดภัย Firestore (v20)
// v40 ถอนระบบเข้าสู่ระบบ/ออกจากระบบออกทั้งหมดตามที่เจ้าของร้านขอ — แอปเปิดแล้วใช้ได้ทันที เชื่อมคลาวด์เองโดยไม่ต้องล็อกอิน
// จึงเปิดสิทธิ์เฉพาะ 3 collection ที่แอปใช้จริง (ลูกค้า / งานซ่อม / ตั้งค่าร้าน) ส่วนอื่นปิดหมด
// หมายเหตุสำคัญ: เนื่องจากไม่มีระบบล็อกอินแล้ว ความปลอดภัยขึ้นกับการเก็บลิงก์เว็บไว้เป็นความลับภายในร้าน
// (ห้ามเผยแพร่ลิงก์ fixpro-7b397.web.app ต่อสาธารณะ เพราะใครที่รู้ลิงก์+project id จะเข้าถึงข้อมูลได้)
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ข้อมูลลูกค้า (doc id = เบอร์โทร)
    match /customers/{phone} {
      allow read, write: if true;
    }

    // ประวัติงานซ่อม
    match /jobs/{id} {
      allow read, write: if true;
    }

    // การตั้งค่าร้าน (ซิงค์ข้ามเครื่อง: shop/settings) + รายการเบอร์ที่ผู้ใช้ลบแล้ว (shop/deleted_phones)
    match /shop/{doc} {
      allow read, write: if true;
    }

    // collection ทดสอบการเชื่อมต่อ (ปุ่ม "ทดสอบ" ในหน้าตั้งค่า) — อ่านอย่างเดียว
    match /_test_/{doc} {
      allow read: if true;
    }

    // ตัวตรวจว่ากฎ deploy ถึงเซิร์ฟเวอร์จริงหรือไม่ (ว่างเปล่า ไม่มีข้อมูล อ่านอย่างเดียว)
    // GET ได้ 200 = กฎรุ่นนี้ live แล้ว / 403 = ยังเป็นกฎรุ่นเก่า
    match /_public_probe/{doc} {
      allow read: if true;
    }

    // นอกเหนือจากนี้ ปิดหมดทุกกรณี (รวม users — ไม่ใช้แล้วหลังถอนระบบล็อกอิน)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
